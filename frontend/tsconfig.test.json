{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "incremental": false,
    "outDir": ".test-build",
    "types": ["node"]
  },
  "include": ["core/**/*.ts", "lib/**/*.ts", "memory/**/*.ts", "database/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "app", ".next", ".test-build"]
}
